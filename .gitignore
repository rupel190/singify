# dependencies
node_modules/

# build output
# NB: `dist/*`, not `dist/` — git never descends into an excluded *directory*, so a `!` negation
# inside it can never re-include anything. Excluding the contents instead leaves the door open.
dist/*
# ...and the Marketplace bundle stays in: `manifest.json` points `main` here, and the Spicetify
# Marketplace fetches it straight from the default branch, so it has to be committed.
!dist/karaoke.js

# bun
.bun/

# nix / direnv (local cache)
.direnv/

# local test charts (CC-licensed .txt files for harness testing — not redistributed)
charts/

# editor / OS
.DS_Store
*.log

# Claude Code local settings + temp files
.claude/settings.local.json
.claude/*.tmp.*

# local secrets / config
config.json
.env
.env.*

# nix build output
result
